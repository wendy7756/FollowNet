{
  "$schema": "https://zeabur.com/schema.json",
  "name": "follownet",
  "services": [
    {
      "name": "backend",
      "source": {
        "type": "git"
      },
      "rootDirectory": "backend",
      "environment": {
        "PORT": "8000",
        "FRONTEND_URL": "https://www.follownet.online"
      },
      "healthCheck": {
        "path": "/",
        "timeout": 30
      },
      "plan": "hobby",
      "regions": ["auto"]
    }
  ]
} 